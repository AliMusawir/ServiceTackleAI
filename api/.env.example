# ==============================================================================
# ServiceTackle AI — Server Environment Configuration
# Copy this file to .env (inside /api/.env or root /.env) on Hostinger
# ==============================================================================

# 1. Admin Email (Where you want to receive new leads and job applications)
ADMIN_EMAIL=contact@servicetackle.com
COMPANY_NAME=ServiceTackle AI
SITE_URL=https://servicetackle.com

# 2. Sender Email for Auto-Responders
SMTP_FROM_EMAIL=no-reply@servicetackle.com

# 3. OpenAI GPT API Key (For client-catching chatbot)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# 4. Google Sheets Webhook URL (For 1-click careers auto-sync)
# Create a Google Sheet, paste the script in google-sheets/Code.gs, deploy as Web App, and paste the URL below:
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-google-apps-script-id/exec
